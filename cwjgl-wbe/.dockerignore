# ============================================================================
# .dockerignore - Docker 构建排除文件
# 减小镜像体积，加快构建速度
# ============================================================================

# Git 相关
.git
.gitignore
.gitattributes

# Node.js 相关
node_modules
npm-debug.log
yarn-error.log
.npm
.node-gyp

# 环境变量文件
.env.test
.env.local
.env.*.local

# IDE 和编辑器
.vscode
.idea
.DS_Store
*.swp
*.swo
*.swn
.cursor
.cursorignore

# 开发构建文件
dist
build
.cache
.next
out

# 测试相关
coverage
.nyc_output
*.lcov

# 数据库和日志（本地开发文件，不需要在镜像中）
db/chat.db
logs

# 文档和配置文件（部署时可选）
CHANGELOG.md
PULL_REQUEST_TEMPLATE.md
.github

# 临时文件
*.tmp
*.temp
*.bak
.DS_Store
Thumbs.db

# 构建产物
*.tar.gz
*.zip

# Docker 和 CI/CD
docker-compose.override.yml
.dockerignore
Dockerfile
.gitlab-ci.yml
.github
.travis.yml
Jenkinsfile

# 开发文档
docs
examples
README.dev.md
CONTRIBUTING.md

# 调试和追踪文件
trace.txt
debug-prompt.txt
*.log

# 测试脚本（生产环境不需要）
test-*.js
check-*.js
inspect-*.js
show-*.js

# 分析报告
*_REPORT.md
*_ANALYSIS.md
*_DIAGNOSTIC.md
